# Supabase (Database & Auth)
# Get these from: https://supabase.com/dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xpcraeknfkhfptoggiuv.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=sb_publishable_ZG4kvLjCw18rPyTpVyNBCA_nupnmBaA

# Cloudflare R2 (Music Storage)
# Get these from: https://dash.cloudflare.com -> R2
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=your-bucket-name

# Public R2 URL (where your songs are publicly accessible)
NEXT_PUBLIC_R2_PUBLIC_URL=https://your-public-url.r2.dev

# Telegram Bot (Support Messages)
# Get token from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Optional: API Base URL (defaults to localhost in dev)
# NEXT_PUBLIC_API_URL=https://your-domain.com
