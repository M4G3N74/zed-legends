{
  "name": "music-stream-next",
  "version": "1.0.0",
  "description": "A music streaming application with auto-play functionality",
  "private": true,
  "scripts": {
    "dev": "NODE_ENV=development NEXT_PUBLIC_API_URL=http://localhost:3000 next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write .",
    "build:static": "next build && next export",
    "generate-voices": "node scripts/generate-voices.js",
    "generate-voices-supabase": "node scripts/generate-voices-supabase.cjs",
    "migrate-voices": "node scripts/migrate-voices-to-supabase.js",
    "setup-pronunciations": "node scripts/create-pronunciations-table.js",
    "check-voice-cache": "node scripts/check-voice-cache.js",
    "test-voice": "node scripts/test-voice-generation.js"
  },
  "keywords": [
    "music",
    "streaming",
    "autoplay",
    "javascript",
    "nextjs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.835.0",
    "@aws-sdk/s3-request-presigner": "^3.835.0",
    "@supabase/supabase-js": "^2.50.1",
    "@vercel/analytics": "^1.5.0",
    "archiver": "^7.0.1",
    "dotenv": "^16.5.0",
    "music-metadata": "^11.3.0",
    "next": "15.3.8",
    "node-id3": "^0.2.9",
    "p-limit": "^5.0.0",
    "pg": "^8.16.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "styled-jsx": "^5.1.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.15",
    "@types/react": "^19.1.8",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.4",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.8.3"
  }
}
