{
  "name": "music-stream-next",
  "version": "1.0.0",
  "description": "A music streaming application with auto-play functionality",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "server": "node server.js",
    "dev:server": "nodemon server.js",
    "dev:all": "concurrently \"npm run dev:server\" \"npm run dev\"",
    "start:all": "concurrently \"npm run server\" \"npm run start\"",
    "build:static": "next build && next export",
    "start:optimized": "node server-optimized.js"
  },
  "keywords": [
    "music",
    "streaming",
    "autoplay",
    "javascript",
    "nextjs"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.835.0",
    "@aws-sdk/s3-request-presigner": "^3.835.0",
    "@supabase/supabase-js": "^2.50.1",
    "@vercel/analytics": "^1.5.0",
    "archiver": "^7.0.1",
    "dotenv": "^16.5.0",
    "music-metadata": "^11.3.0",
    "next": "^15.3.4",
    "node-id3": "^0.2.9",
    "pg": "^8.16.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.0",
    "eslint": "^9.29.0",
    "eslint-config-next": "^15.3.4",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.4"
  }
}
